---
title: Git ignore politikası
description: Kaynak depoya girmemesi gereken yerel, üretilen ve hassas dosyalar.
status: active
updated_at: 2026-09-17
---

# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# testing / coverage
coverage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example hariç, gerçek değerler asla commit edilmez
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# mobil (Faz 2 — native Android/Kotlin, bkz. decisions/0005)
android/local.properties
android/.gradle/
android/*/build/
android/.idea/
*.keystore
*.jks

# codex yerel ortam dosyaları (araç tarafından üretiliyor, paylaşılmıyor)
.codex/
