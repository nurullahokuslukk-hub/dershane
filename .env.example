# Supabase proje ayarları (Project Settings → API sekmesinden alınır)
# Bkz. docs/decisions/0002-teknik-mimari.md — proje EU/Frankfurt bölgesinde
# oluşturulmalı.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# Yalnızca sunucu tarafında kullanılır (admin işlemleri — kullanıcı oluşturma
# vb. için gerektiğinde). Asla NEXT_PUBLIC_ önekiyle tarayıcıya sızdırılmaz.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"
